<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UsageGuard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.UsageGuard.Lock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lock_bg</item>
        <item name="android:statusBarColor">@color/lock_bg</item>
        <item name="android:navigationBarColor">@color/lock_bg</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
